<?xml version='1.0' encoding='UTF-8'?>
<ExtensionManifest ExtensionBundleId="voideditor.transcriptai" ExtensionBundleVersion="0.0.1" Version="7.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="voideditor.transcriptai.panel" Version="0.0.1" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="15.4" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="7.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="voideditor.transcriptai.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Void Editor — Whisper Engine</Menu>
          <Geometry>
            <Size>
              <Height>900</Height>
              <Width>900</Width>
            </Size>
            <MinSize>
              <Height>700</Height>
              <Width>700</Width>
            </MinSize>
            <MaxSize>
        	  <Height>1200</Height>
        	  <Width>1400</Width>
    		</MaxSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
